import math
from turtle import *
def square_a(n):
    return 15 * math.sin(n) ** 3
def square_b(n):
    return 12 * math.cos(n)-5 *\
    math.cos(2*n) -2 *\
    math.cos(3*n) -2 *\
    math.cos(4*n)
    
speed(0)
bgcolor("black")
for i in range(500):
    goto(square_a(i)*15,square_b(i)*15)
    for j in range(1):
        color("red")
    hideturtle()
    
done()